# Шаблон файла .env НА СЕРВЕРЕ (рядом с docker-compose.yml).
#
# Обычно этот файл создавать вручную не нужно — его пишет ./nasiya install.
# Пригодится, если разворачиваете без install.sh: скопировать в .env,
# заполнить, выставить права chmod 600, в git не коммитить.

# Ваш базовый домен без поддомена и протокола. Компания будет жить на
# поддомене: <COMPANY_SLUG>.<этот домен>. Меняется через ./nasiya settings.
APP_DOMAIN=пример.ру

# Почта для Let's Encrypt: туда придут письма об истечении сертификатов
ACME_EMAIL=admin@пример.ру

# Пароль пользователя Postgres. Сгенерировать:
#   openssl rand -hex 24
PG_PASSWORD=

# Служебное — читают только scripts/*.sh при ./nasiya settings и ./nasiya status,
# само приложение эти четыре ключа не использует.
COMPANY_SLUG=acme
COMPANY_NAME=ООО Акме
ADMIN_EMAIL=admin@example.ru
ADMIN_NAME=Администратор
