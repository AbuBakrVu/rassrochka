# Шаблон файла .env НА СЕРВЕРЕ (рядом с docker-compose.yml).
# Скопировать в .env, заполнить, выставить права: chmod 600 .env
# В git не коммитить.

# Ваш базовый домен без поддомена и протокола. Компании будут жить на
# поддоменах: acme.<этот домен>. Меняется только здесь — в коде домена нет.
APP_DOMAIN=пример.ру

# Почта для Let's Encrypt: туда придут письма об истечении сертификатов
ACME_EMAIL=admin@пример.ру

# Пароль пользователя Postgres. Сгенерировать:
#   openssl rand -base64 24
PG_PASSWORD=
