# Скопируйте в .env.local (разработка) или .env (сервер) и заполните.
# .env* в git не попадает — см. .gitignore.

# Базовый URL Postgres БЕЗ имени базы: имя подставляется на лету,
# потому что у каждой компании своя база.
#   локально (brew postgres от текущего пользователя):
PG_BASE_URL=postgres://localhost:5432
#   на сервере (Docker Compose, сервис называется db):
# PG_BASE_URL=postgres://finora:ПАРОЛЬ@db:5432

# Реестр компаний
CONTROL_DB=finora_control

# Служебная база для CREATE/DROP DATABASE — к ней подключаемся, когда
# создаём чужую базу. Менять обычно не нужно.
# PG_MAINTENANCE_DB=postgres

# Секрет для подписи сессионных кук. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Базовый домен: по нему из Host вычисляется slug компании
# (acme.finora.ru → acme). Локально удобно finora.local.
APP_DOMAIN=finora.local
