# Скопируйте в .env.local (разработка) или .env (сервер) и заполните.
# .env* в git не попадает — см. .gitignore.

# Базовый URL Postgres БЕЗ имени базы: имя подставляется на лету,
# потому что у каждой компании своя база.
#   локально (brew postgres от текущего пользователя):
PG_BASE_URL=postgres://localhost:5432
#   на сервере (Docker Compose, сервис называется db):
# PG_BASE_URL=postgres://nasiya:ПАРОЛЬ@db:5432

# Реестр компаний
CONTROL_DB=nasiya_control

# Служебная база для CREATE/DROP DATABASE — к ней подключаемся, когда
# создаём чужую базу. Менять обычно не нужно.
# PG_MAINTENANCE_DB=postgres

# Секрет для подписи сессионных кук. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Базовый домен установки: по нему из Host вычисляется slug компании.
#   acme.nasiya.ru → компания acme, nasiya.ru → страница выбора компании
# Для разработки удобно "localhost": браузеры сами резолвят *.localhost
# в 127.0.0.1, и demo.localhost:3000 работает без правки /etc/hosts.
APP_DOMAIN=localhost

# Запасная компания, когда поддомена в адресе нет (голый localhost:3000).
# Работает ТОЛЬКО вне production — в проде компания берётся из домена.
DEV_TENANT_SLUG=demo
