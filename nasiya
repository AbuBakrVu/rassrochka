#!/usr/bin/env bash
# Единая точка входа для управления сервером.
#
#   ./nasiya install    — первая установка (после git clone)
#   ./nasiya update      — обновить код из git и накатить миграции
#   ./nasiya settings    — сменить домен, почту или пароль сотрудника
#   ./nasiya status       — проверить, что всё работает
#   ./nasiya backup        — сделать резервную копию прямо сейчас
#   ./nasiya backup-setup  — настроить копии в облако и расписание
#   ./nasiya restore       — восстановить базу из копии
#   ./nasiya proxy-setup   — общий прокси для сервера с несколькими сервисами
#   ./nasiya deploy root@IP — с вашего компьютера: поставить на новый сервер
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

cmd="${1:-}"
[ $# -gt 0 ] && shift

case "$cmd" in
  install)  exec bash scripts/install.sh "$@" ;;
  update)   exec bash scripts/update.sh "$@" ;;
  settings) exec bash scripts/settings.sh "$@" ;;
  status)   exec bash scripts/status.sh "$@" ;;
  backup-setup) exec bash scripts/backup-setup.sh "$@" ;;
  restore)  exec bash scripts/restore.sh "$@" ;;
  deploy)   exec bash scripts/deploy.sh "$@" ;;
  proxy-setup) exec bash scripts/proxy-setup.sh "$@" ;;
  clear-test-data)
    . scripts/lib.sh
    compose exec -T app node scripts/clear-test-data.mjs "$@"
    ;;
  backup)
    [ -f .env ] && set -a && . ./.env && set +a
    exec bash scripts/backup.sh "$@"
    ;;
  *)
    cat <<'EOF'
Использование: ./nasiya <команда>

  install    первичная установка на чистый сервер
  update     обновить код из git и применить миграции
  settings   сменить домен, e-mail для сертификатов, пароль сотрудника
  status     проверить состояние сервисов и сайта
  backup     запустить резервное копирование прямо сейчас
  backup-setup  настроить копии в облако, шифрование и расписание
  restore    восстановить базу компании из копии (latest — самую свежую)
  proxy-setup  общий прокси, если на сервере несколько веб-сервисов
  clear-test-data [--yes]  удалить тестовых клиентов и сделки из nasiya-test-import.xlsx

С вашего компьютера:
  deploy root@<IP> [--shared]  поставить на новый сервер одной командой
EOF
    exit 1
    ;;
esac
